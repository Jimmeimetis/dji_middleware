# Copy to secrets.properties (git-ignored) and fill in.
# DJI developer app key, registered for package com.dji.sampleV5.aircraft
DJI_API_KEY=
MAPLIBRE_TOKEN=
GMAP_API_KEY=
# Ikaros INTERNAL_API_KEY for the target deployment (sent as the fbauthtoken header)
IKAROS_TOKEN=
# Password for the RTMP ingest user
RTMP_PASS=

# ── Local stack (ops/dev docker-compose on a machine on the LAN) ──────
# The landing screen's "Local" preset fills the form from these, so a
# developer can point the app at their own machine and back at dev01
# without editing anything or losing the AWS values.
#
# LOCAL_HOST is the LAN address of the machine running docker-compose -
# not localhost, which on an Android tablet means the tablet. Host only;
# the ports are fixed by the compose file (3000 / 1935 / 8890).
LOCAL_HOST=
# The local stack's INTERNAL_API_KEY, from ops/dev/.env.
LOCAL_IKAROS_TOKEN=
# RTMP_PUBLISH_PASSWORD from ops/dev/.env. Defaults to ikaros-dev-publish.
LOCAL_RTMP_PASS=
